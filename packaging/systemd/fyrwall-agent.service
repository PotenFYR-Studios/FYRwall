[Unit]
Description=FYRwall local firewall agent
Documentation=https://github.com/PotenFYR-Studios/FYRwall
After=network.target

[Service]
Type=simple
User=fyrwall
Group=fyrwall
ExecStart=/usr/bin/fyrwall agent --config /etc/fyrwall/config.yaml
Restart=on-failure
RestartSec=5
RuntimeDirectory=fyrwall
RuntimeDirectoryMode=0750

# The agent is unprivileged; firewall mutation happens through the
# privileged helper, not this process.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
